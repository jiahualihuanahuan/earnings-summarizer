# Default: Ollama on the homelab (native /api/chat, no API key).
# From Docker, use the host LAN IP (192.168.86.35), not localhost.
# Ollama itself must listen on 0.0.0.0, e.g.:
#   OLLAMA_HOST=0.0.0.0 OLLAMA_CONTEXT_LENGTH=8192 ollama serve
USE_OLLAMA=true
OLLAMA_BASE_URL=http://192.168.86.35:11434
OLLAMA_MODEL=qwen3.5:9b
# Disable Qwen thinking mode for faster summaries (Ollama "think": false).
OLLAMA_THINK=false

SYNC_INTERVAL_HOURS=1
DATABASE_PATH=./data/earnings.db
# HF_TOKEN=

# Alternative: vLLM (OpenAI-compatible). Set USE_OLLAMA=false and fill these in.
# USE_OLLAMA=false
# LLM_BASE_URL=http://192.168.86.35:8001/v1
# LLM_MODEL=qwen3.5-9b
# LLM_API_KEY=
